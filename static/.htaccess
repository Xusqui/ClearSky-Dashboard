# Cache HTTP para assets estáticos (CSS/JS). El cache-busting real (?v=filemtime)
# se hace en index.php vía asset_v(), así que estos archivos pueden cachearse
# de forma agresiva: el navegador solo re-descarga cuando la URL cambia.
# No afecta a los endpoints PHP (get_*.php, images.php, etc.) porque el
# FilesMatch solo cubre las extensiones .css y .js.

<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(css|js)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
